{
  "expo": {
    "name": "CareOn",
    "slug": "careon",
    "version": "1.0.0",
    "scheme": "careon",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careon.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.careon.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "88f4d44f-c1b1-4509-8666-6d608b8890fd"
      }
    },
    "owner": "jatin-verma"
  }
}
